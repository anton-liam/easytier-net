# A/B nodes: iStoreOS base image
# iStoreOS is based on OpenWrt, provides UCI, procd, fw4, nftables
# Uses official OpenWrt rootfs — arm64 native on Apple Silicon Mac

FROM ghcr.io/openwrt/rootfs:armsr-armv8

# Install packages that iStoreOS ships by default on R3S/RPi
RUN mkdir -p /var/lock && \
    opkg update && \
    opkg install \
      nftables \
      ip-full \
      kmod-nft-nat \
      kmod-tun \
      curl \
      ca-bundle \
      bash \
      procps-ng-ps \
      tcpdump && \
    rm -f /tmp/opkg-lists/*

# EasyTier binaries will be downloaded or mounted at runtime
# Config mounted at /etc/easytier/

COPY entrypoint-istoreos.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
