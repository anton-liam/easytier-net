# C (web/control) and D (client) nodes
# ubuntu:24.04 is multi-arch (amd64/arm64), auto-selects native platform

FROM ubuntu:24.04

RUN apt-get update && apt-get install -y --no-install-recommends \
      iproute2 \
      iputils-ping \
      nftables \
      curl \
      ca-certificates \
      tcpdump \
      procps \
      jq \
    && rm -rf /var/lib/apt/lists/*

# TODO: C will run easytier-web + easytier-core (config-server mode)
# Binaries downloaded or mounted at runtime

COPY entrypoint-ubuntu.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
