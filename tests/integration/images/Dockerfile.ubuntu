# C (web/control) and D (client) nodes
# ubuntu:24.04 is multi-arch (amd64/arm64), auto-selects native platform

FROM ubuntu:24.04

# Docker Desktop's internal proxy (http.docker.internal:3128) corrupts GPG
# signatures. Use [trusted=yes] to bypass verification in test images only.
RUN sed -i 's|Signed-By: .*$|Trusted: yes|g' /etc/apt/sources.list.d/ubuntu.sources 2>/dev/null || true

RUN apt-get update && apt-get install -y --no-install-recommends \
      iproute2 \
      iputils-ping \
      nftables \
      curl \
      ca-certificates \
      tcpdump \
      procps \
      jq \
      netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

# TODO: C will run easytier-web + easytier-core (config-server mode)
# Binaries downloaded or mounted at runtime

COPY entrypoint-ubuntu.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
