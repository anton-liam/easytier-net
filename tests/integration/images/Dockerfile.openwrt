# A/B nodes: OpenWrt rootfs with nft, ip, ping pre-installed
# OpenWrt manifest uses non-standard arch "aarch64_generic", must pin by digest
FROM ghcr.io/openwrt/rootfs@sha256:ca327ed17491406b438bbad2cf4f9202f89bd768371c43aacd4b165775e76314

# Core tools (nft, ip, ping, sh) are already in the base image.
# No opkg in this minimal rootfs — skip package install.

COPY entrypoint-openwrt.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
