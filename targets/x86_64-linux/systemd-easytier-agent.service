[Unit]
Description=EasyTier Managed Node Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/easytier-agent/agent.env
ExecStart=/usr/local/bin/easytier-agent run --config /etc/easytier-agent/agent.toml
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

